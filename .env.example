# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored and must never be committed.

# Documentation screenshot generator / manual QA scripts.
WF_USERNAME=eehab_said
WF_PASSWORD=Eehabdev1

# ---- Production hardening (see wealthflow/env_settings.py) ----
# Leave all of these unset for local development (DEBUG on, dev key, HTTP).
# WEALTHFLOW_DEBUG=false
# WEALTHFLOW_SECRET_KEY=<50+ random characters>
# WEALTHFLOW_ALLOWED_HOSTS=wealthflow.pythonanywhere.com
# WEALTHFLOW_CSRF_TRUSTED_ORIGINS=https://wealthflow.pythonanywhere.com
# Set when a reverse proxy (PythonAnywhere, nginx, ...) terminates HTTPS:
# WEALTHFLOW_BEHIND_PROXY=true
# WEALTHFLOW_PROXY_COUNT=1
# Stable key for stored AI credentials (otherwise derived from SECRET_KEY):
# WEALTHFLOW_AI_ENCRYPTION_KEY=
