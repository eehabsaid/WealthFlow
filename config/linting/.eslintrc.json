{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "globals": {
    "t": "readonly",
    "currentLang": "readonly",
    "formatDate": "readonly",
    "showModal": "readonly",
    "closeModal": "readonly",
    "showToast": "readonly",
    "showLoading": "readonly",
    "hideLoading": "readonly"
  },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "error",
    "no-debugger": "error"
  },
  "ignorePatterns": [
    "node_modules/",
    "venv/"
  ]
}