{
  "name": "dev-agent",
  "displayName": "dev_agent",
  "description": "Chat sidebar for the standalone dev_agent coding agent: plan review, live steps, diffs, approvals, Stop.",
  "version": "0.1.0",
  "publisher": "wealthflow",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p ./ && node scripts/copy-web.js",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devAgent",
          "title": "dev_agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "devAgent": [
        {
          "type": "webview",
          "id": "devAgent.chat",
          "name": "Chat",
          "icon": "static/images/favicon.ico"
        }
      ]
    },
    "commands": [
      {
        "command": "devAgent.focus",
        "title": "Open chat",
        "category": "dev_agent"
      },
      {
        "command": "devAgent.stop",
        "title": "Stop the running task",
        "category": "dev_agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devAgent.restartServer",
        "title": "Restart server",
        "category": "dev_agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "devAgent.showLog",
        "title": "Show log",
        "category": "dev_agent"
      },
      {
        "command": "devAgent.setApiKey",
        "title": "Set API key",
        "category": "dev_agent"
      },
      {
        "command": "devAgent.deleteApiKey",
        "title": "Remove API key",
        "category": "dev_agent"
      }
    ],
    "configuration": {
      "title": "dev_agent",
      "properties": {
        "devAgent.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter that runs the agent (3.10+, 3.12 recommended). Empty = auto-detect (.venv, venv, py -3.12, python3)."
        },
        "devAgent.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Project folder the agent works on. Empty = the first workspace folder."
        },
        "devAgent.agentPath": {
          "type": "string",
          "default": "",
          "description": "Folder that contains the dev_agent package. Empty = the project folder."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "devAgent.stop",
          "when": "view == devAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "devAgent.restartServer",
          "when": "view == devAgent.chat",
          "group": "1_server"
        },
        {
          "command": "devAgent.showLog",
          "when": "view == devAgent.chat",
          "group": "1_server"
        },
        {
          "command": "devAgent.setApiKey",
          "when": "view == devAgent.chat",
          "group": "2_keys"
        },
        {
          "command": "devAgent.deleteApiKey",
          "when": "view == devAgent.chat",
          "group": "2_keys"
        }
      ]
    }
  }
}
