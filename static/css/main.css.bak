:root {
  --bg-primary: #0a0f1e;
  --bg-secondary: #0d1530;
  --bg-tertiary: #111d3d;
  --border-color: #1e3a6e;
  --accent-primary: #1a6ef5;
  --accent-hover: #2d7fff;
  --accent-green: #00d68f;
  --accent-red: #ff4d6d;
  --accent-yellow: #ffd166;
  --text-primary: #e8f0fe;
  --text-secondary: #7b93c9;
  --text-muted: #4a6399;
  --sidebar-width: 240px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  font-size: 14px;
  min-height: 100vh;
}

/* ── Layout ── */
#app {
  display: flex;
  min-height: 100vh;
}

.nav-section-header {
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.85rem;
  padding: 10px 15px;
  background: var(--bg-secondary);
}

.nav-section-content {
  display: block;
  /* Default open */
  padding-left: 10px;
}

.sidebar-separator {
  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  margin: 10px 0;
}

.nav-item i.bi-chevron-down {
  font-size: 0.8rem;
  transition: transform 0.3s;
}

/* Rotate chevron when expanded */
.nav-item[aria-expanded="true"] i.bi-chevron-down {
  transform: rotate(180deg);
}

#sidebar {
  width: var(--sidebar-width);
  min-height: 100vh;
  background: var(--bg-secondary);
  border-right: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  inset-inline-start: 0;
  z-index: 100;
  transition: width 0.25s;
}

#page-wrapper {
  margin-left: var(--sidebar-width);
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

#topbar {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

#main-content {
  padding: 24px;
  flex: 1;
}

/* ── Sidebar brand ── */
.sidebar-brand {
  padding: 20px 16px;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 10px;
}

.sidebar-brand .brand-icon {
  width: 36px;
  height: 36px;
  background: var(--accent-primary);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.sidebar-brand .brand-text {
  font-weight: 700;
  font-size: 13px;
  color: var(--text-primary);
  line-height: 1.3;
}

/* ── Sidebar nav ── */
.sidebar-nav {
  flex: 1;
  padding: 12px 0;
  overflow-y: auto;
}

.nav-section-label {
  padding: 10px 16px 4px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .05em;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 16px;
  color: var(--text-secondary);
  cursor: pointer;
  border-radius: 6px;
  margin: 2px 8px;
  font-size: 13.5px;
  transition: background .15s, color .15s;
  text-decoration: none;
  border: none;
  background: none;
  width: calc(100% - 16px);
  text-align: left;
}

.nav-item:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.nav-item.active {
  background: rgba(26, 110, 245, .18);
  color: var(--accent-primary);
  font-weight: 600;
}

.nav-item .nav-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── Cards / KPI ── */
.kpi-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 20px;
  transition: border-color .2s;
}

.kpi-card:hover {
  border-color: var(--accent-primary);
}

.kpi-card .kpi-label {
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .05em;
  margin-bottom: 8px;
}

.kpi-card .kpi-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--text-primary);
}

.kpi-card .kpi-sub {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 4px;
}

/* ── Tables ── */

.data-table {
  width: 100%;
  border-collapse: collapse;
  background-color: var(--bg-secondary) !important;
  background: var(--bg-secondary) !important;
  border-radius: 10px;
  overflow: hidden;
}

.data-table tbody {
  background-color: var(--bg-secondary) !important;
  background: var(--bg-secondary) !important;
}

.data-table * {
  background-color: var(--bg-secondary) !important;
  background: var(--bg-secondary) !important;
    color: var(--text-primary);
  font-size: 13.5px;
}
.data-table tr:hover, 
.data-table tr:hover * {
  background-color: var(--bg-tertiary) !important;
}
.data-table *::selection {
    background-color: var(--accent-primary) !important;
    color: #ffffff !important;
}
.data-table input::selection {
    background-color: var(--accent-primary) !important;
    color: #ffffff !important;
}
.data-table input {
    background-color: transparent !important; /* Let the parent row background show through */
    color: var(--text-primary) !important;
    
}
.data-table th {
  background-color: var(--bg-secondary) !important;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .05em;
  padding: 10px 14px;
  text-align: left;
  border-bottom: 1px solid var(--border-color);
}

.data-table td {
  padding: 11px 14px;
  border-bottom: 1px solid rgba(30, 58, 110, .35);
  color: var(--text-primary);
  font-size: 13.5px;
  background-color: var(--bg-secondary) !important;
  background: var(--bg-secondary) !important;
}

.data-table tr:last-child td {
  border-bottom: none;
}

.data-table tbody tr:hover {
  background: var(--text-primary);

}

.data-table .total-row td {
  background-color: var(--bg-secondary) !important;
  background: var(--bg-secondary) !important;
  font-weight: 700;
  color: var(--accent-yellow);
  border-top: 1px solid var(--border-color);
}

/* ── Amount colours ── */
.amt-positive {
  color: var(--accent-green);
}

.amt-negative {
  color: var(--accent-red);
}

.amt-zero {
  color: var(--text-muted);
}

/* ── Year pills ── */
.year-pills {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.year-pill {
  padding: 5px 14px;
  border-radius: 20px;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  transition: all .15s;
}

.year-pill:hover {
  border-color: var(--accent-primary);
  color: var(--accent-primary);
}

.year-pill.active {
  background: var(--accent-primary);
  color: #fff;
  border-color: var(--accent-primary);
}

/* ── Buttons ── */
.btn-primary-custom {
  background: var(--accent-primary);
  color: #fff;
  border: none;
  border-radius: 7px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s;
}

.btn-primary-custom:hover {
  background: var(--accent-hover);
}

.btn-secondary-custom {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm, 6px);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all .15s;
}

.btn-secondary-custom:hover {
  background: var(--border-color);
  color: var(--text-primary);
  border-color: var(--accent-primary);
}

.btn-icon {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 7px;
  border-radius: 5px;
  font-size: 14px;
  transition: all .15s;
}

.btn-icon:hover {
  color: var(--text-primary);
  background: var(--bg-tertiary);
}

.btn-icon.del:hover {
  color: var(--accent-red);
}

/* ── Modal ── */
.modal-dark .modal-content {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
}

.modal-dark .modal-header {
  border-bottom: 1px solid var(--border-color);
}

.modal-dark .modal-footer {
  border-top: 1px solid var(--border-color);
}

.modal-dark .form-control,
.modal-dark .form-select {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
}

.modal-dark .form-control:focus,
.modal-dark .form-select:focus {
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px rgba(26, 110, 245, .25);
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.modal-dark label {
  color: var(--text-secondary);
  font-size: 12.5px;
  font-weight: 600;
}

/* ── Page header ── */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
}

.page-subtitle {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 2px;
}

/* ── Currency cards (Balance) ── */
.currency-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 18px 20px;
  text-align: center;
}

.currency-card .cur-flag {
  font-size: 28px;
  margin-bottom: 8px;
}

.currency-card .cur-code {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 700;
}

.currency-card .cur-amount {
  font-size: 22px;
  font-weight: 700;
  color: var(--accent-green);
  margin-top: 4px;
}

/* ── Settings tabs ── */
.settings-tab {
  background: none;
  border: none;
  color: var(--text-secondary);
  padding: 8px 18px;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: all .15s;
}

.settings-tab.active {
  color: var(--accent-primary);
  border-bottom-color: var(--accent-primary);
}

/* ── Toast ── */
#toast-container .toast {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
}

/* ── RTL support ── */
[dir="rtl"] #sidebar {
  left: auto;
  right: 0;
  border-right: none;
  border-left: 1px solid var(--border-color);
}

[dir="rtl"] #page-wrapper {
  margin-left: 0;
  margin-right: var(--sidebar-width);
}

[dir="rtl"] .data-table th,
[dir="rtl"] .data-table td {
  text-align: right;
}

/* ── Loading spinner ── */
.spinner-overlay {
  display: none;
  /* hidden by default */
  align-items: center;
  justify-content: center;
  min-height: 200px;
  color: var(--text-muted);
  background: rgba(0, 0, 0, 0.03);
}

/* ── Group badge ── */
.group-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
  background: rgba(26, 110, 245, .15);
  color: var(--accent-primary);
  margin-left: 6px;
}

/* old icon-only sidebar removed — see mobile section below */


/* ════════════════════════════════════════════════════════════
   RESPONSIVE LAYOUT — Desktop fixed sidebar + Mobile offcanvas
   ════════════════════════════════════════════════════════════ */

/* ── Hamburger button — HIDDEN on desktop, shown on mobile ── */
#sidebarToggle {
  display: none;
  background: none;
  border: none;
  color: var(--text-primary);
  font-size: 22px;
  padding: 4px 8px;
  cursor: pointer;
  line-height: 1;
}

/* ── Sidebar overlay — only used on mobile ── */
#sidebarOverlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1049;
}

#sidebarOverlay.show {
  display: block;
}

/* ── Sidebar close button — hidden on desktop ── */
#sidebarClose {
  display: none;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
  margin-left: auto;
}

/* ══════════════════════════════════════
   DESKTOP (>= 992px): Normal fixed sidebar
   ══════════════════════════════════════ */
@media (min-width: 992px) {
  #sidebar {
    position: fixed;
    inset-inline-start: 0;
    top: 0;
    width: var(--sidebar-width);
    height: 100vh;
    transform: translateX(0) !important;
  }

  #page-wrapper {
    margin-left: var(--sidebar-width);
  }

  [dir="rtl"] #sidebar {
    left: auto;
    right: 0;
  }

  [dir="rtl"] #page-wrapper {
    margin-left: 0;
    margin-right: var(--sidebar-width);
  }

  #sidebarToggle {
    display: none !important;
  }

  #sidebarClose {
    display: none !important;
  }
}

/* ══════════════════════════════════════
   MOBILE (< 992px): Offcanvas sidebar
   ══════════════════════════════════════ */
@media (max-width: 991.98px) {

  /* Sidebar slides off-screen by default */
  #sidebar {
    position: fixed;
    left: -260px;
    top: 0;
    width: 245px !important;
    height: 100vh;
    z-index: 1050;
    transition: left 0.28s ease;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);
  }

  #sidebar.open {
    left: 0;
  }

  /* RTL mobile */
  [dir="rtl"] #sidebar {
    inset-inline-start: 0;
    right: -260px;
    transition: right 0.28s ease;
  }

  [dir="rtl"] #sidebar.open {
    right: 0;
  }

  /* Page fills full width — no sidebar margin */
  #page-wrapper {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  /* Show hamburger */
  #sidebarToggle {
    display: inline-flex !important;
    align-items: center;
  }

  /* Show close button inside sidebar */
  #sidebarClose {
    display: inline-flex !important;
  }

  /* Sidebar labels always visible (it's full offcanvas) */
  #sidebar .brand-text,
  #sidebar .nav-section-label,
  #sidebar .nav-group-label,
  #sidebar .nav-item span,
  #sidebar .nav-item .nav-text {
    display: block !important;
  }

  #sidebar .nav-item {
    justify-content: flex-start !important;
    padding: 9px 12px !important;
  }

  /* Tables scroll horizontally */
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .data-table {
    min-width: 600px;
  }

  /* Page header stacks */
  .page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  /* Topbar tighter */
  #topbar {
    padding: 0 12px;
    gap: 8px;
  }

  #main-content {
    padding: 16px 12px 48px;
  }
}

/* ══════════════════════════════════════
   SMALL MOBILE (< 576px)
   ══════════════════════════════════════ */
@media (max-width: 575.98px) {
  .page-title {
    font-size: 18px;
  }

  .kpi-value {
    font-size: 20px !important;
  }

  .grand-total-value {
    font-size: 24px;
  }

  .year-pills {
    gap: 5px;
  }

  .year-pill {
    padding: 4px 11px;
    font-size: 11.5px;
  }

  .btn-primary-custom {
    padding: 7px 12px;
    font-size: 12.5px;
  }

  /* Modal full-width on tiny screens */
  .modal-dialog {
    margin: 8px;
  }

  .modal-body .col-sm-6,
  .modal-body .col-sm-4,
  .modal-body .col-sm-3 {
    width: 100% !important;
    flex: 0 0 100%;
  }
}

/* ════════════════════════════════════════════════════════════
   EXPENSE PAGE STYLES
   ════════════════════════════════════════════════════════════ */

.expense-filters {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 14px 16px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
}

.expense-filters .form-select,
.expense-filters .form-control {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  font-size: 13px;
  padding: 5px 10px;
  border-radius: var(--radius-sm);
}

.expense-filters .form-select:focus,
.expense-filters .form-control:focus {
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 2px var(--accent-glow);
  outline: none;
}

/* Category badge pill */
.cat-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 11.5px;
  font-weight: 700;
}

/* ════════════════════════════════════════════════════════════
   REPORT PAGE STYLES
   ════════════════════════════════════════════════════════════ */

.report-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 14px 0;
}

.report-controls .form-select,
.report-controls .form-control {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  font-size: 13px;
  padding: 7px 12px;
  border-radius: var(--radius-sm);
  min-width: 130px;
}

.report-controls .form-select:focus,
.report-controls .form-control:focus {
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 2px var(--accent-glow);
  outline: none;
}

/* ════════════════════════════════════════════════════════════
   NAVIGATION — Grouped nav items
   ════════════════════════════════════════════════════════════ */

.nav-group-label {
  padding: 10px 16px 3px;
  font-size: 10px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .08em;
}

.nav-item.nav-sub {
  padding-left: 30px;
  font-size: 13px;
}

.nav-item.nav-sub .nav-dot {
  width: 5px;
  height: 5px;
}

/* Close button for mobile sidebar overlay */
#sidebarClose {
  display: none;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
  margin-left: auto;
}

/* sidebarClose mobile handled in main responsive block */

/* ════════════════════════════════════════════════════════════
   PHASE 2: SIDEBAR & LAYOUT RESPONSIVE MEDIA OVERRIDES
   ════════════════════════════════════════════════════════════ */

@media (max-width: 991.98px) {

  /* Remove fixed layout properties from desktop */
  #page-wrapper {
    margin-left: 0 !important;
    width: 100% !important;
    padding-top: 60px;
  }

  /* Target your exact javascript .open variable class */
  #sidebar.open {
    transform: translateX(0) !important;
    box-shadow: 5px 0 25px rgba(0, 0, 0, 0.5);
  }

  /* Force sidebar onto an absolute off-canvas layout sheet layer */
  #sidebar {
    position: fixed !important;
    top: 0;
    inset-inline-start: 0;
    height: 100vh !important;
    z-index: 1050 !important;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Target your exact javascript background .show overlay variable class */
  #sidebarOverlay.show {
    display: block !important;
    opacity: 1 !important;
  }

  #sidebarOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(4, 6, 14, 0.75);
    backdrop-filter: blur(3px);
    z-index: 1040 !important;
    display: none;
    opacity: 0;
    transition: opacity 0.3s linear;
  }

  #topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    z-index: 1030;
    display: flex !important;
    align-items: center;
    padding: 0 15px !important;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 3: DATA TABLE RESPONSIVENESS
   ════════════════════════════════════════════════════════════ */

/* Global selector target intercepting any data view wrappers holding table elements */
#main-content table {
  width: 100%;
  margin-bottom: 1rem;
  vertical-align: top;
}

/* Responsive container wrapper engine applied on mobile dimensions */
@media (max-width: 1024px) {

  /* Capture table parent blocks to make them responsive dynamically */
  div.table-responsive,
  .card-body,
  #main-content .table,
  #main-content th,
  #main-content td {
    white-space: nowrap;
    /* Prevents text elements like dates and numbers from packing awkwardly */
  }

  /* Force tables to become smoothly scrollable horizontally within container walls */
  #main-content .card,
  #main-content .table-parent,
  div:has(> table) {
    overflow-x: auto !important;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    /* GPU accelerated friction scrolling for iPhones/iPads */
    position: relative;
  }

  /* Optimize table cell touch targets and alignment spacing for small viewports */
  #main-content th,
  #main-content td {
    padding: 10px 12px !important;
    font-size: 13px !important;
    /* Slightly more compact to maximize row overview visibility */
  }

  /* Add a custom aesthetic visual hint indicating the container table scrolls horizontally */
  div:has(> table)::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 15px;
    background: linear-gradient(to left, rgba(13, 21, 48, 0.4), rgba(13, 21, 48, 0));
    pointer-events: none;
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 4: FORMS RESPONSIVENESS
   ════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {

  /* Transition multi-column form grids into fluid stacking single-column layouts */
  #main-content form .row>[class*="col-"] {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    margin-bottom: 15px;
  }

  /* Optimize input controls, text fields, and select dropdown heights for touch interactions */
  #main-content .form-control,
  #main-content .form-select {
    min-height: 44px !important;
    /* Enforces mobile minimum touch targets */
    font-size: 16px !important;
    /* Prevents iOS Safari from automatically zooming in on focus */
    padding: 10px 14px !important;
  }

  /* Standardize spacing around form groups and descriptive field labels */
  #main-content form label {
    margin-bottom: 6px !important;
    font-size: 13px !important;
  }

  /* Make action buttons within form panels easier to tap on mobile devices */
  #main-content form .btn,
  #main-content .form-actions .btn {
    width: 100% !important;
    min-height: 44px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    font-size: 15px !important;
  }

  /* Arrange grouped form actions inline or in a block when stacked */
  #main-content form .btn-group,
  #main-content .form-actions {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    gap: 0;
  }

  /* Ensure report and data control filter panels wrap nicely on mobile viewports */
  .report-controls,
  .filter-bar {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
  }

  .report-controls .form-select,
  .report-controls .form-control {
    width: 100% !important;
    min-width: 100% !important;
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 5: DASHBOARD RESPONSIVENESS
   ════════════════════════════════════════════════════════════ */

@media (max-width: 991.98px) {

  /* Provide comfortable breathing room around the main viewport layout */
  #main-content {
    padding: 15px !important;
  }

  /* Target Bootstrap and custom card grid layouts to break down on tablets/mobiles */
  #main-content .row {
    margin-left: -8px !important;
    margin-right: -8px !important;
    gap: 0;
  }

  #main-content .row>[class*="col-"] {
    padding-left: 8px !important;
    padding-right: 8px !important;
    margin-bottom: 16px !important;
  }
}

@media (max-width: 768px) {

  /* Re-grid metrics grids to show 2 cards per line on typical tablet sizes */
  #main-content .row>.col-xl-3,
  #main-content .row>.col-md-6,
  #main-content .row>.col-6 {
    width: 50% !important;
    flex: 0 0 50% !important;
    max-width: 50% !important;
  }

  /* Optimize layout metrics inside individual metric summary cards */
  .stat-card,
  .metric-card,
  #main-content .card-body {
    padding: 14px !important;
  }

  /* Ensure text headings scale well without clipping or line-wrapping overlaps */
  .stat-card h3,
  .metric-card .card-title,
  #main-content h2 {
    font-size: 1.1rem !important;
    line-height: 1.3;
  }

  .stat-card p,
  .metric-card .value {
    font-size: 1.4rem !important;
    font-weight: 700;
  }
}

@media (max-width: 480px) {

  /* Force metric cards to stack completely into 1 single column on compact mobile screens */
  #main-content .row>.col-xl-3,
  #main-content .row>.col-md-6,
  #main-content .row>.col-6,
  #main-content .row>[class*="col-"] {
    width: 100% !important;
    flex: 0 0 100% !important;
    max-width: 100% !important;
  }

  /* Optimize top header action rows to stack cleanly */
  .dashboard-header,
  .page-header-actions {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
    margin-bottom: 20px !important;
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 6: CHARTS RESPONSIVENESS
   ════════════════════════════════════════════════════════════ */

/* Standardize chart canvas containers for independent responsiveness */
.chart-container,
div:has(> canvas) {
  position: relative !important;
  width: 100% !important;
  height: 320px !important;
  /* Set a reliable desktop height baseline */
  margin-bottom: 20px;
}

@media (max-width: 768px) {

  /* Scale heights slightly on mobile screens to save vertical space */
  .chart-container,
  div:has(> canvas) {
    height: 260px !important;
  }
}

@media (max-width: 400px) {

  /* Ensure compact mobile viewports scale cleanly */
  .chart-container,
  div:has(> canvas) {
    height: 220px !important;
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 7: MODAL RESPONSIVENESS
   ════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {

  /* Expand the main modal overlay window safely to avoid edge clipping */
  #modal-container .modal-dialog,
  .custom-modal-dialog,
  #app+.modal .modal-dialog {
    max-width: calc(100% - 24px) !important;
    margin: 12px auto !important;
  }

  /* Optimize modal body inner spaces for small device viewports */
  #modal-container .modal-content,
  .custom-modal-content {
    padding: 16px !important;
    border-radius: var(--radius-md, 8px) !important;
    background: var(--bg-secondary) !important;
  }

  /* Make header close icons and titles easy to read and touch */
  #modal-container .modal-header,
  .custom-modal-header {
    padding-bottom: 12px !important;
    margin-bottom: 16px !important;
  }

  /* Ensure long forms inside modals scroll safely vertically if they exceed viewport heights */
  #modal-container .modal-body,
  .custom-modal-body {
    max-height: calc(100vh - 140px) !important;
    overflow-y: auto !important;
    padding: 0 !important;
  }

  /* Scale footer action buttons to stack elegantly at the bottom of the form context */
  #modal-container .modal-footer,
  .custom-modal-footer {
    padding-top: 16px !important;
    margin-top: 16px !important;
    display: flex !important;
    flex-direction: column-reverse !important;
    /* Puts the primary 'Save' button above the 'Cancel' button */
    gap: 10px !important;
  }

  #modal-container .modal-footer .btn,
  .custom-modal-footer .btn {
    width: 100% !important;
    margin: 0 !important;
    /* Strips Bootstrap default margin gaps */
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 8: MOBILE NAVIGATION IMPROVEMENTS
   ════════════════════════════════════════════════════════════ */

@media (max-width: 991.98px) {

  /* Enforce structural container bounds on the sticky topbar navigation link band */
  #topbar {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 12px;
  }

  /* Wrap page title typography blocks securely inside the top utility header line */
  #topbar .page-title,
  #topbar h1,
  #topbar h4 {
    font-size: 16px !important;
    font-weight: 600 !important;
    margin: 0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 1;
    color: var(--text-primary);
  }

  /* Organize utility profile controls and buttons symmetrically inside the top layout bar */
  #topbar .user-profile,
  #topbar .header-right {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  /* Ensure button icons match minimum touch requirements without breaking bar layouts */
  #topbar .btn-icon,
  #topbar .profile-trigger {
    width: 38px !important;
    height: 38px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
  }

  /* Optimize operational sub-header sections across individual workspace view models */
  .section-header,
  .view-title-container {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 10px !important;
    padding-bottom: 12px !important;
    margin-bottom: 16px !important;
    border-bottom: 1px solid var(--border-color);
  }

  /* Expand quick data filtering panels to fill full screen widths on small viewports */
  .view-title-container .actions-wrapper,
  .section-header .btn-group {
    width: 100% !important;
    display: flex !important;
    gap: 8px !important;
  }

  .view-title-container .actions-wrapper .btn,
  .section-header .btn-group .btn {
    flex: 1 1 auto !important;
    min-height: 40px !important;
    font-size: 13px !important;
  }
}

/* ════════════════════════════════════════════════════════════
   PHASE 9: FINAL CSS CLEANUP & OPTIMIZATION
   ════════════════════════════════════════════════════════════ */

/* Global smoothness and layout overflow safeguards */
html,
body {
  overflow-x: hidden !important;
  /* Locks structural layout horizontally */
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
  /* Removes blue tap highlight on mobile safari */
}

/* Optimize scrollbar footprints on mobile browsers inside tables */
@media (max-width: 1024px) {
  ::-webkit-scrollbar {
    height: 5px !important;
    width: 5px !important;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--border-color) !important;
    border-radius: 10px !important;
  }

  ::-webkit-scrollbar-track {
    background: transparent !important;
  }
}

@media (max-width: 576px) {

  /* Prevent large dynamic card values from breaking container boxes */
  .stat-card p,
  .metric-card .value,
  .balance-amount {
    font-size: 1.25rem !important;
    word-break: break-all !important;
    white-space: normal !important;
  }

  /* Safe interactive margins around action groupings */
  .btn,
  .form-control,
  .form-select {
    margin-top: 2px !important;
    margin-bottom: 2px !important;
  }

  /* Optimize modal and toast alert positioning for mobile viewports */
  #toast-container {
    left: 12px !important;
    right: 12px !important;
    bottom: 12px !important;
    width: auto !important;
  }

  .toast {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Ensure profile pictures or avatar circles scale cleanly in responsive rows */
  .avatar-circle,
  img[class*="profile"],
  img[class*="avatar"] {
    width: 34px !important;
    height: 34px !important;
    object-fit: cover;
  }
}

/* Hardware acceleration boost to prevent animation stuttering on older mobile viewports */
#sidebar,
#sidebarOverlay {
  backface-visibility: hidden;
  perspective: 1000px;
  will-change: transform, opacity;
}


/* ════════════════════════════════════════════════════════════
   FIXED DASHBOARD CHART RESPONSIEVNESS (OPTION B)
   ════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {

  /* Target any column bars/flex metrics grids on the dashboard view */
  #main-content div[style*="height"] {
    overflow: visible !important;
  }

  #salaryChart {
    min-height: 450px !important;
  }

  .dashboard-chart-card,
  .chart-container {
    min-height: 500px;
  }

  /* Target the text labels and company name spans at the base of the bars */
  #main-content div[style*="height"] .text-center,
  #main-content div[style*="height"] [style*="font-size"],
  #main-content div[style*="height"] span {
    font-size: 10px !important;
    display: inline-block !important;
    white-space: nowrap !important;
    /* Rotate company labels 45 degrees downwards to maximize width layout clearance */
    transform: rotate(-45deg) translate(-12px, -2px) !important;
    transform-origin: left center !important;
  }

  /* Inject extra vertical breathing space below the chart container box so labels do not clip */
  #main-content .card:has(div[style*="height"]),
  #main-content div:has(> div[style*="height"]) {
    padding-bottom: 45px !important;
  }
}
[dir="rtl"] #sidebar {
    left: auto !important;
    right: 0 !important;
    border-right: none !important;
    border-left: 1px solid var(--border-color) !important;
}

[dir="rtl"] #page-wrapper {
    margin-left: 0 !important;
    margin-right: var(--sidebar-width) !important;
}