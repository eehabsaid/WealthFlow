{
  "max_file_lines": 200,
  "index_roots": ["core", "wealthflow", "scripts", "static/js"],
  "protected": [
    {"pattern": "core/services/financial_advisor/cash_flow_forecast_service/*", "reason": "Cash Flow calculation: the owner never wants it changed without approval"},
    {"pattern": "core/services/shared/currency_conversion_service.py", "reason": "central currency conversion: additive changes only, list callers first"},
    {"pattern": "core/services/shared/base_currency.py", "reason": "central base-currency logic: additive changes only, list callers first"},
    {"pattern": "core/services/shared/base_currency_recalc.py", "reason": "recalculates stored amounts in the base currency"},
    {"pattern": "core/services/shared/market_profile.py", "reason": "central market profile: additive changes only"},
    {"pattern": "core/services/shared/latest_rates.py", "reason": "shared latest-exchange-rate lookup"},
    {"pattern": "core/services/exchange_rate_history_service/*", "reason": "central exchange-rate history: additive changes only"},
    {"pattern": "core/services/balance/*", "reason": "balances and net worth: financial calculations"},
    {"pattern": "core/services/expenses/expense_balance_helpers.py", "reason": "moves money between balances when expenses change"},
    {"pattern": "core/services/expenses/expense_service.py", "reason": "expense posting changes balances"},
    {"pattern": "core/services/salary/*", "reason": "salary and per-diem postings change balances"},
    {"pattern": "core/validators/ownership.py", "reason": "multi-tenancy: every user must see only their own rows"},
    {"pattern": "core/authentication/*", "reason": "authentication, sessions and permissions"},
    {"pattern": "core/services/billing/*", "reason": "payments and plan access"},
    {"pattern": "core/migrations/*", "reason": "database migrations; never edit one that was already applied"},
    {"pattern": "db.sqlite3", "reason": "tracked on purpose; never edit by hand"},
    {"pattern": ".env", "reason": "secrets"}
  ],
  "test_areas": {
    "core/services/ai": "core.tests.ai",
    "core/views/ai_chat": "core.tests.ai",
    "core/views/ai_speech": "core.tests.ai",
    "core/services/balance": "core.tests.balance",
    "core/models/balance": "core.tests.balance",
    "core/services/expenses": "core.tests.expenses",
    "core/views/expense": "core.tests.expenses",
    "core/services/salary": "core.tests.salary",
    "core/services/budgets": "core.tests.budgets",
    "core/services/fixed_assets": "core.tests.fixed_assets",
    "core/models/fixed_assets": "core.tests.fixed_assets",
    "core/services/financial_advisor": "core.tests.financial_advisor",
    "core/services/billing": "core.tests.billing",
    "core/services/account": "core.tests.account",
    "core/authentication": "core.tests.auth",
    "core/services/backup_serializer": "core.tests.system",
    "core/services/certificate": "core.tests.certificates",
    "core/services/import_data": "core.tests.import_data",
    "core/services/legal": "core.tests.legal",
    "core/services/shared/currency": "core.tests.currency",
    "core/services/shared/base_currency": "core.tests.currency",
    "core/services/reports": "core.tests.reports",
    "core/views/settings": "core.tests.settings",
    "static/i18n": "core.tests.i18n"
  }
}
