{
  "max_file_lines": 200,
  "index_roots": ["core", "ai", "wealthflow", "scripts", "static/js"],
  "protected": [
    {"pattern": "core/services/financial_advisor/cash_flow_forecast_service/*", "reason": "Cash Flow calculation: the owner never wants it changed without approval"},
    {"pattern": "core/services/shared/currency_conversion_service.py", "reason": "central currency conversion: additive changes only, list callers first"},
    {"pattern": "core/services/shared/base_currency.py", "reason": "central base-currency logic: additive changes only, list callers first"},
    {"pattern": "core/services/shared/base_currency_recalc.py", "reason": "recalculates stored amounts in the base currency"},
    {"pattern": "core/services/shared/market_profile.py", "reason": "central market profile: additive changes only"},
    {"pattern": "core/services/shared/latest_rates.py", "reason": "shared latest-exchange-rate lookup"},
    {"pattern": "core/services/exchange_rate_history_service/*", "reason": "central exchange-rate history: additive changes only"},
    {"pattern": "core/services/balance/*", "reason": "balances and net worth: financial calculations"},
    {"pattern": "core/services/expenses/expense_balance_helpers.py", "reason": "moves money between balances when expenses change"},
    {"pattern": "core/services/expenses/expense_service.py", "reason": "expense posting changes balances"},
    {"pattern": "core/services/salary/*", "reason": "salary and per-diem postings change balances"},
    {"pattern": "core/validators/ownership.py", "reason": "multi-tenancy: every user must see only their own rows"},
    {"pattern": "core/authentication/*", "reason": "authentication, sessions and permissions"},
    {"pattern": "core/services/billing/*", "reason": "payments and plan access"},
    {"pattern": "core/migrations/*", "reason": "database migrations; never edit one that was already applied"},
    {"pattern": "db.sqlite3", "reason": "tracked on purpose; never edit by hand"},
    {"pattern": ".env", "reason": "secrets"}
  ],
  "test_areas": {
    "ai/services": "ai.tests",
    "ai/views/ai_chat": "ai.tests",
    "ai/views/ai_speech": "ai.tests",
    "core/services/balance": "core.tests.balance",
    "core/models/balance": "core.tests.balance",
    "core/services/expenses": "core.tests.expenses",
    "core/views/expense": "core.tests.expenses",
    "core/services/salary": "core.tests.salary",
    "core/services/budgets": "core.tests.budgets",
    "core/services/fixed_assets": "core.tests.fixed_assets",
    "core/models/fixed_assets": "core.tests.fixed_assets",
    "core/services/financial_advisor": "core.tests.financial_advisor",
    "core/services/billing": "core.tests.billing",
    "core/services/account": "core.tests.account",
    "core/authentication": "core.tests.auth",
    "core/services/backup_serializer": "core.tests.system",
    "core/services/certificate": "core.tests.certificates",
    "core/services/import_data": "core.tests.import_data",
    "core/services/legal": "core.tests.legal",
    "core/services/shared/currency": "core.tests.currency",
    "core/services/shared/base_currency": "core.tests.currency",
    "core/services/reports": "core.tests.reports",
    "core/views/settings": "core.tests.settings",
    "static/i18n": "core.tests.i18n",
    "ai/training": "ai.training.tests",
    "ai/integrations/ai_provider": "ai.tests",
    "ai/integrations/openai_provider": "ai.tests",
    "ai/integrations/claude_provider": "ai.tests",
    "ai/integrations/gemini_provider": "ai.tests",
    "ai/integrations/azure_openai_provider": "ai.tests",
    "core/integrations": "core.tests.rates_and_automation",
    "core/services/exchange_rate_history_service": "core.tests.rates_and_automation",
    "core/services/shared/reminder_automation_service": "core.tests.rates_and_automation",
    "core/services/shared": "core.tests.currency",
    "core/services/restore": "core.tests.system",
    "core/utils": "core.tests.system",
    "core/validators": "core.tests.system",
    "core/middleware": "core.tests.system",
    "wealthflow": "core.tests.system",
    "core/services/onboarding": "core.tests.auth",
    "core/constants": "ai.tests",
    "core/models/billing": "core.tests.billing",
    "core/models/certificate": "core.tests.certificates",
    "ai/models": "ai.tests",
    "core/reports": "core.tests.reports",
    "core/reports/generate_report_generator": "core.tests.certificates",
    "core/reports/fixed_asset": "core.tests.fixed_assets",
    "core/views/balance": "core.tests.balance",
    "core/views/salary": "core.tests.salary",
    "core/views/fixed_assets": "core.tests.fixed_assets",
    "ai/views/ai_platform": "ai.tests",
    "core/models/expenses": "core.tests.expenses",
    "core/models/salary": "core.tests.salary",
    "core/models/budget": "core.tests.budgets",
    "core/models/legal": "core.tests.legal",
    "core/models/currency": "core.tests.currency",
    "core/models/exchange_rate": "core.tests.rates_and_automation",
    "core/models/authentication": "core.tests.auth",
    "core/models/permissions": "core.tests.auth",
    "core/models/settings": "core.tests.settings",
    "core/models/reminders": "core.tests.rates_and_automation",
    "core/models/documentation": "core.tests.settings",
    "core/models/scenario": "core.tests.financial_advisor",
    "core/models/goals": "core.tests.financial_advisor",
    "core/models/gold": "core.tests.fixed_assets"
  },
  "pytest_areas": {"ai/dev_agent/": "ai/dev_agent/tests"},
  "test_exempt": ["scripts/*", "manage.py", "*/migrations/*", "*/__init__.py"],
  "agent_index_roots": [
    "core",
    "wealthflow",
    "scripts",
    "static/js",
    "templates",
    "tests",
    "ai"
  ],
  "forbidden": [
    "core/migrations/*",
    "*/migrations/*.py",
    "db.sqlite3",
    ".env"
  ],
  "secret_files": [
    ".env",
    "*.env",
    "*.pem",
    "*id_rsa*",
    "*.pfx",
    ".webui_secret_key"
  ],
  "test_command": [
    "python",
    "manage.py",
    "test",
    "{modules}"
  ],
  "commands": {
    "allow": [
      [
        "python",
        "manage.py",
        "check"
      ],
      [
        "python",
        "manage.py",
        "test"
      ],
      [
        "python",
        "manage.py",
        "makemigrations"
      ],
      [
        "python",
        "-m",
        "pyflakes"
      ],
      [
        "python",
        "-m",
        "pytest"
      ],
      [
        "npx",
        "eslint"
      ],
      [
        "npx",
        "htmlhint"
      ],
      [
        "npx",
        "stylelint"
      ],
      [
        "npx",
        "prettier"
      ]
    ],
    "ask": [
      [
        "python",
        "manage.py",
        "migrate"
      ],
      [
        "python",
        "scripts",
        "run_full_e2e.py"
      ]
    ],
    "deny": [
      [
        "python",
        "manage.py",
        "flush"
      ],
      [
        "python",
        "manage.py",
        "sqlflush"
      ],
      [
        "python",
        "manage.py",
        "dbshell"
      ]
    ],
    "ask_args": [
      "--fix",
      "--write",
      "-w",
      "--fix-type"
    ]
  },
  "verify_steps": [
    {
      "name": "django check",
      "argv": [
        "python",
        "manage.py",
        "check"
      ]
    },
    {
      "name": "makemigrations --check",
      "argv": [
        "python",
        "manage.py",
        "makemigrations",
        "--check",
        "--dry-run"
      ],
      "ext": [
        ".py"
      ]
    },
    {
      "name": "pyflakes",
      "argv": [
        "python",
        "-m",
        "pyflakes",
        "{files}"
      ],
      "ext": [
        ".py"
      ]
    },
    {
      "name": "pytest (dev_agent)",
      "argv": ["python", "-m", "pytest", "-q", "{pytest}"],
      "ext": [".py"]
    },
    {
      "name": "django tests",
      "argv": [
        "python",
        "manage.py",
        "test",
        "{modules}"
      ],
      "ext": [
        ".py"
      ]
    },
    {
      "name": "eslint",
      "argv": [
        "npx",
        "eslint",
        "--no-eslintrc",
        "-c",
        "config/linting/.eslintrc.json",
        "{files}"
      ],
      "ext": [
        ".js"
      ]
    },
    {
      "name": "stylelint",
      "argv": [
        "npx",
        "stylelint",
        "--config",
        "config/linting/.stylelintrc.json",
        "{files}"
      ],
      "ext": [
        ".css"
      ]
    },
    {
      "name": "htmlhint",
      "argv": [
        "npx",
        "htmlhint",
        "--config",
        "config/linting/.htmlhintrc",
        "{files}"
      ],
      "ext": [
        ".html"
      ]
    },
    {
      "name": "prettier",
      "argv": [
        "npx",
        "prettier",
        "--config",
        "config/linting/.prettierrc.json",
        "--check",
        "{files}"
      ],
      "ext": [
        ".js",
        ".css"
      ]
    }
  ],
  "e2e": {
    "paths": [
      "static/*",
      "templates/*"
    ],
    "command": "python scripts/run_full_e2e.py"
  }
}
