# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored and must never be committed.
#
# Used by the documentation screenshot generator (scripts/generate_docs.py,
# triggered from Settings > Documentation in the UI) and the manual
# QA/e2e scripts under scripts/ to log in without hardcoding credentials
# in source. Restart "python manage.py runserver" after creating/editing
# this file so the new values are picked up.

WF_USERNAME=eehab_said
WF_PASSWORD=Eehabdev1

# --- Real-Ollama acceptance test (core/tests/ai_pack/from_ai/investigation/test_guide_real_ollama.py) ---
# TESTS=1 runs it against your local Ollama; anything else (0, empty) or removing/commenting these lines skips it.
# A variable already set in your shell wins over this file.
WEALTHFLOW_REAL_OLLAMA_TESTS=1
WEALTHFLOW_REAL_OLLAMA_MODEL=qwen3.8:27b-coding_agent
# Optional (defaults shown):
# WEALTHFLOW_REAL_OLLAMA_URL=http://127.0.0.1:11434
# WEALTHFLOW_REAL_OLLAMA_CONTEXT=32768
# WEALTHFLOW_REAL_OLLAMA_OUTPUT_DIR=
