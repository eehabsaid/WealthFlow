+"use strict";
+
+/* Voice-only sentence polling and playback; normal chat remains a single validated JSON response. */
+(function () {
+  const S = window.WFSpeech;
+  const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+  const oldAfterAnswer = S.afterAnswer;
+  const oldStop = S.stop;
+  const oldToggle = S.toggleSpeakLast;
+
+  function finish(session) {
+    if (session.cleaned) return;
+    session.cleaned = true;
+    clearInterval(session.pollTimer);
+    session.pollAbort.abort();
+    session.audioAbort.abort();
+    if (session.audio) session.audio.pause();
+    session.placeholder?.closest(".ai-ws-msg")?.remove();
+    if (S.streamSession === session) S.streamSession = null;
+    S.paintSpeaking(false);
+    S.indicator.hide("speaking");
+  }
+  S.finishStream = finish;
+
+  function reveal(session, text) {
+    session.hasSentences = true;
+    session.text += `${session.text ? " " : ""}${text}`;
+    if (!session.placeholder) {
+      _appendMessage("assistant", "", null, null, new Date().toISOString(), null, 0);
+      session.placeholder = S.lastAssistantContent();
+      session.placeholder?.setAttribute("dir", "auto");
+      const role = session.placeholder?.closest(".ai-ws-msg-body")?.querySelector(".ai-ws-msg-role");
+      S.indicator.show(role, "speaking", t("speech_generating", "Preparing voice…"));
+    }
+    if (session.placeholder) session.placeholder.innerHTML = _renderMarkdown(session.text);
+    const box = document.getElementById("ai-ws-messages");
+    if (box) box.scrollTop = box.scrollHeight;
+  }
+
+  async function poll(session) {
+    try {
+      while (!session.cancelled && !session.failed && !session.blocked) {
+        const response = await fetch(
+          `${S.api}/voice-chunks/${session.id}/?after=${session.offset}`,
+          { cache: "no-store", signal: session.pollAbort.signal }
+        );
+        if (!response.ok) throw new Error("Voice sentence stream is unavailable.");
+        const result = await response.json();
+        result.sentences.forEach((text) => {
+          session.offset += 1;
+          session.queue.push(text);
+          reveal(session, text);
+        });
+        if (result.blocked || result.failed) {
+          session.blocked = !!result.blocked;
+          session.failed = !!result.failed;
+          session.queue.length = 0;
+          if (session.audio) session.audio.pause();
+          break;
+        }
+        if (result.done) {
+          session.done = true;
+          break;
+        }
+        if (!result.sentences.length) await pause(160);
+      }
+    } catch (_error) {
+      if (!session.cancelled) {
+        session.failed = true;
+        session.queue.length = 0;
+        if (session.audio) session.audio.pause();
+      }
+    } finally {
+      session.done = true;
+    }
+  }
+
+  S.startStream = function (id) {
+    S.cancelStream();
+    S.skipAfterAnswer = false;
+    const session = {
+      id,
+      offset: 0,
+      queue: [],
+      text: "",
+      cancelled: false,
+      done: false,
+      failed: false,
+      blocked: false,
+      hasSentences: false,
+      answerComplete: false,
+      audioComplete: false,
+      autoplayBlocked: false,
+      pollAbort: new AbortController(),
+      audioAbort: new AbortController(),
+      audio: null,
+      placeholder: null,
+      cleaned: false,
+    };
+    S.streamSession = session;
+    S.paintSpeaking(true);
+    S.indicator.show(
+      document.querySelector(".ai-ws-input-box"),
+      "speaking",
+      t("speech_generating", "Preparing voice…"),
+      document.getElementById("ai-ws-input")
+    );
+    poll(session);
+    S.playStreamQueue(session);
+  };
+
+  S.prepareStreamFinal = function () {
+    const session = S.streamSession;
+    session?.placeholder?.closest(".ai-ws-msg")?.remove();
+    if (session) session.placeholder = null;
+  };
+
+  S.cancelStream = function () {
+    const session = S.streamSession;
+    if (!session) return;
+    session.cancelled = true;
+    finish(session);
+  };
+
+  S.afterAnswer = function (text) {
+    if (S.skipAfterAnswer) {
+      S.skipAfterAnswer = false;
+      return;
+    }
+    const session = S.streamSession;
+    if (!session) return oldAfterAnswer(text);
+    S.prepareStreamFinal();
+    if (!session.hasSentences || session.failed || session.blocked) {
+      const speakFallback = !session.cancelled && !session.autoplayBlocked;
+      finish(session);
+      if (speakFallback) return oldAfterAnswer(text);
+      return;
+    }
+    session.answerComplete = true;
+    if (session.audioComplete) finish(session);
+  };
+
+  S.stop = function () {
+    if (S.streamSession) S.skipAfterAnswer = true;
+    S.cancelStream();
+    oldStop();
+  };
+
+  S.toggleSpeakLast = function () {
+    return S.streamSession ? S.stop() : oldToggle();
+  };
+})();
diff --git a/static/js/ai/ai_speech_stream_playback.js b/static/js/ai/ai_speech_stream_playback.js
new file mode 100644
--- /dev/null
+++ b/static/js/ai/ai_speech_stream_playback.js
@@ -0,0 +1,101 @@
+"use strict";
+
+/* TTS producer/consumer for the opt-in sentence stream. */
+(function () {
+  const S = window.WFSpeech;
+  const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+  async function synthesize(text, session) {
+    const response = await fetch(`${S.api}/synthesize/`, {
+      method: "POST",
+      headers: S.csrfHeaders({ "Content-Type": "application/json" }),
+      body: JSON.stringify({ text }),
+      signal: session.audioAbort.signal,
+    });
+    if (response.status === 204) return null;
+    if (!response.ok) throw new Error(t("speech_tts_failed", "Speech generation failed."));
+    return response.blob();
+  }
+
+  function play(blob, session) {
+    return new Promise((resolve, reject) => {
+      const url = URL.createObjectURL(blob);
+      const audio = new Audio(url);
+      const done = () => {
+        URL.revokeObjectURL(url);
+        if (session.audio === audio) session.audio = null;
+        resolve();
+      };
+      session.audio = audio;
+      audio.onended = done;
+      audio.onerror = () => {
+        URL.revokeObjectURL(url);
+        if (session.audio === audio) session.audio = null;
+        reject(new Error(t("speech_tts_failed", "Audio playback failed.")));
+      };
+      audio.onpause = () => {
+        if (session.cancelled || session.failed || session.blocked) done();
+      };
+      audio.play().catch((error) => {
+        URL.revokeObjectURL(url);
+        if (session.audio === audio) session.audio = null;
+        if (error?.name === "NotAllowedError") session.autoplayBlocked = true;
+        reject(error);
+      });
+    });
+  }
+
+  async function take(session) {
+    while (!session.cancelled && !session.failed && !session.blocked) {
+      if (session.queue.length) return session.queue.shift();
+      if (session.done) return null;
+      await pause(70);
+    }
+    return null;
+  }
+
+  function takeGroup(session, first) {
+    let text = first;
+    while (session.queue.length && text.length + session.queue[0].length + 1 <= 200)
+      text += ` ${session.queue.shift()}`;
+    return text;
+  }
+
+  async function playQueue(session) {
+    try {
+      const first = await take(session);
+      if (!first) return;
+      let pending = synthesize(first, session);
+      while (pending) {
+        const blob = await pending;
+        if (session.cancelled || session.failed || session.blocked) return;
+        if (!blob && session.done && !session.queue.length) break;
+        const next = take(session).then((text) =>
+          text ? synthesize(takeGroup(session, text), session) : null
+        );
+        if (blob) {
+          S.indicator.setLabel("speaking", t("speech_speaking", "Speaking…"));
+          await play(blob, session);
+        }
+        pending = next;
+      }
+    } catch (error) {
+      if (!session.cancelled && !session.autoplayBlocked) {
+        session.failed = true;
+        S.notify(error.message || t("speech_tts_failed", "Speech generation failed."), "error");
+      } else if (session.autoplayBlocked) {
+        S.notify(
+          t("speech_autoplay_blocked", "The browser blocked audio playback. Press the speaker button to listen."),
+          "warning"
+        );
+      }
+    } finally {
+      session.audioComplete = true;
+      S.paintSpeaking(false);
+      S.indicator.hide("speaking");
+      if (session.answerComplete || session.cancelled) S.finishStream(session);
+    }
+  }
+
+  S.playStreamQueue = playQueue;
+})();
